# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login session tokens — required for signup/login to work.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Backend's own public URL — used to build absolute links (email tracking pixel,
# Calendly webhook URL). Leave unset locally; set to your Railway URL in production.
PUBLIC_BASE_URL=

# --- Real integrations (optional) ---
# When these are unset, LeadFlow runs in MOCK mode: emails/calendar events are
# simulated in-memory and logged to the console instead of hitting real APIs.

DATABASE_URL=

# Google Cloud OAuth (Gmail API + Calendar API).
# Setup: create an OAuth Client ID (Web application) in Google Cloud Console with
# Gmail API + Calendar API enabled, add GOOGLE_REDIRECT_URI as an authorized redirect
# URI there, set CLIENT_ID/CLIENT_SECRET below, start the server, then visit
# /api/auth/google once to get GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=

# Calendly OAuth app (see calendly.com developer portal).
# Setup: set CLIENT_ID/SECRET/REDIRECT_URI below, start the server, visit
# /api/calendly/connect once to get ACCESS_TOKEN/REFRESH_TOKEN, then visit
# /api/calendly/setup-webhook once to register the booking webhook.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=http://localhost:5000/api/calendly/callback
CALENDLY_ACCESS_TOKEN=
CALENDLY_REFRESH_TOKEN=
